{
  "name": "saeed-ai",
  "version": "4.4.0",
  "description": "Saeed AI 4.4 desktop agent — 3D core with removable add-ons",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --dir --publish never",
    "dist": "electron-builder --win nsis --publish never",
    "test": "node scripts/run-all-tests.js"
  },
  "dependencies": {
    "three": "0.180.0",
    "ws": "8.18.3",
    "electron-updater": "6.6.2"
  },
  "devDependencies": {
    "electron-builder": "26.15.3",
    "electron": "38.8.6"
  },
  "build": {
    "files": [
      "**/*",
      "!build/whisper-runtime/**",
      "!artifacts/**",
      "!dist/**",
      "!animation-health-report.json"
    ],
    "appId": "ai.saeed.desktop",
    "productName": "Saeed AI",
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Saeed.AI.Setup.${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "buildVersion": "4.4.0",
    "icon": "assets/saeed.png",
    "extraResources": [
      {
        "from": "build/whisper-runtime",
        "to": "whisper",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "publish": {
    "provider": "github",
    "owner": "saeedhub101",
    "repo": "Saeed-V2.0",
    "releaseType": "release"
  },
  "author": {
    "name": "Saeed O. Almansour"
  }
}
